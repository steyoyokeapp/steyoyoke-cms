{
  "name": "steyoyoke-cms-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "auth:provision-owner": "tsx scripts/provision-owner-admin.ts",
    "auth:reset-password": "tsx scripts/reset-password.ts",
    "dev:cleanup-e2e": "tsx scripts/cleanup-local-e2e.ts",
    "publish:scheduled": "tsx src/server/run-scheduled-artists.ts",
    "migration:analyze": "tsx scripts/migration/cli.ts analyze",
    "migration:rehearse": "tsx scripts/migration/cli.ts rehearse-import",
    "migration:staging": "tsx scripts/migration/cli.ts staging-import",
    "migration:compare": "tsx scripts/migration/cli.ts compare",
    "migration:report": "tsx scripts/migration/cli.ts report",
    "migration:manifest": "tsx scripts/migration/cli.ts manifest",
    "staging:manifest": "tsx scripts/staging/manifest.ts"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.27.7": true,
    "fsevents@2.3.3": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1130.0",
    "@better-auth/prisma-adapter": "^1.7.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.3",
    "dotenv": "^17.3.1",
    "music-metadata": "^11.15.0",
    "next": "16.3.4",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^7.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
