generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum ArtistStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum AuditAction {
  CREATE
  EDIT
  CHAPTERS_EDIT
  TRACKS_EDIT
  REORDER
  PUBLISH
  SCHEDULE
  CANCEL_SCHEDULE
  UNPUBLISH
  ARCHIVE
  RESTORE
}

enum TrackStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum PodcastStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum ReleaseStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

model User {
  id               String                   @id @default(uuid()) @db.Uuid
  name             String
  email            String                   @unique
  emailVerified    Boolean                  @default(false)
  image            String?
  role             Role                     @default(VIEWER)
  createdAt        DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                 @updatedAt @db.Timestamptz(6)
  sessions         Session[]
  accounts         Account[]
  revisions        ArtistRevision[]
  auditLogs        AuditLog[]
  trackRevisions   TrackRevision[]
  trackAuditLogs   TrackAuditLog[]
  podcastRevisions PodcastEpisodeRevision[]
  podcastAuditLogs PodcastAuditLog[]
  releaseRevisions ReleaseRevision[]
  releaseAuditLogs ReleaseAuditLog[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime @db.Timestamptz(6)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}

model Artist {
  id                        String                   @id @default(uuid()) @db.Uuid
  legacyId                  Int                      @unique @default(autoincrement())
  name                      String
  slug                      String                   @unique
  shortBio                  String?
  facebookUrl               String?
  status                    ArtistStatus             @default(DRAFT)
  workingVersion            Int                      @default(1)
  publishedRevisionId       String?                  @db.Uuid
  scheduledRevisionId       String?                  @db.Uuid
  scheduledFor              DateTime?                @db.Timestamptz(6)
  archivedAt                DateTime?                @db.Timestamptz(6)
  createdAt                 DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                 @updatedAt @db.Timestamptz(6)
  revisions                 ArtistRevision[]         @relation("ArtistRevisions")
  publishedRevision         ArtistRevision?          @relation("PublishedRevision", fields: [id, publishedRevisionId], references: [artistId, id], onDelete: Restrict)
  scheduledRevision         ArtistRevision?          @relation("ScheduledRevision", fields: [id, scheduledRevisionId], references: [artistId, id], onDelete: Restrict)
  auditLogs                 AuditLog[]
  primaryTracks             Track[]                  @relation("TrackPrimaryArtist")
  secondaryTracks           Track[]                  @relation("TrackSecondaryArtist")
  primaryTrackRevisions     TrackRevision[]          @relation("TrackRevisionPrimaryArtist")
  secondaryTrackRevisions   TrackRevision[]          @relation("TrackRevisionSecondaryArtist")
  primaryPodcasts           PodcastEpisode[]         @relation("PodcastPrimaryArtist")
  secondaryPodcasts         PodcastEpisode[]         @relation("PodcastSecondaryArtist")
  primaryPodcastRevisions   PodcastEpisodeRevision[] @relation("PodcastRevisionPrimaryArtist")
  secondaryPodcastRevisions PodcastEpisodeRevision[] @relation("PodcastRevisionSecondaryArtist")
  primaryReleases           Release[]                @relation("ReleasePrimaryArtist")
  secondaryReleases         Release[]                @relation("ReleaseSecondaryArtist")
  primaryReleaseRevisions   ReleaseRevision[]        @relation("ReleaseRevisionPrimaryArtist")
  secondaryReleaseRevisions ReleaseRevision[]        @relation("ReleaseRevisionSecondaryArtist")

  @@index([status])
  @@index([scheduledFor])
  @@map("artists")
}

model ArtistRevision {
  id                   String   @id @default(uuid()) @db.Uuid
  artistId             String   @db.Uuid
  revisionNumber       Int
  sourceWorkingVersion Int
  name                 String
  slug                 String
  shortBio             String?
  facebookUrl          String?
  createdById          String   @db.Uuid
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  artist               Artist   @relation("ArtistRevisions", fields: [artistId], references: [id], onDelete: Restrict)
  createdBy            User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  publishedByArtists   Artist[] @relation("PublishedRevision")
  scheduledForArtists  Artist[] @relation("ScheduledRevision")

  @@unique([artistId, revisionNumber])
  @@unique([artistId, id])
  @@index([createdById])
  @@map("artist_revisions")
}

model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  artistId  String      @db.Uuid
  actorId   String?     @db.Uuid
  action    AuditAction
  metadata  Json?
  createdAt DateTime    @default(now()) @db.Timestamptz(6)
  artist    Artist      @relation(fields: [artistId], references: [id], onDelete: Restrict)
  actor     User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([artistId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

model Label {
  id               String                   @id @default(uuid()) @db.Uuid
  name             String
  slug             String                   @unique
  legacyValue      String                   @unique
  active           Boolean                  @default(true)
  createdAt        DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                 @updatedAt @db.Timestamptz(6)
  tracks           Track[]
  revisions        TrackRevision[]
  podcasts         PodcastEpisode[]
  podcastRevisions PodcastEpisodeRevision[]
  releases         Release[]
  releaseRevisions ReleaseRevision[]

  @@map("labels")
}

model Track {
  id                  String          @id @default(uuid()) @db.Uuid
  legacyId            Int             @unique @default(autoincrement())
  title               String
  primaryArtistId     String          @db.Uuid
  secondaryArtistId   String?         @db.Uuid
  labelId             String          @db.Uuid
  durationMs          Int?
  spotifyUrl          String?
  beatportUrl         String?
  traxsourceUrl       String?
  bandcampUrl         String?
  appleMusicUrl       String?
  soundcloudUrl       String?
  status              TrackStatus     @default(DRAFT)
  workingVersion      Int             @default(1)
  publishedRevisionId String?         @db.Uuid
  scheduledRevisionId String?         @db.Uuid
  scheduledFor        DateTime?       @db.Timestamptz(6)
  archivedAt          DateTime?       @db.Timestamptz(6)
  createdAt           DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(6)
  primaryArtist       Artist          @relation("TrackPrimaryArtist", fields: [primaryArtistId], references: [id], onDelete: Restrict)
  secondaryArtist     Artist?         @relation("TrackSecondaryArtist", fields: [secondaryArtistId], references: [id], onDelete: Restrict)
  label               Label           @relation(fields: [labelId], references: [id], onDelete: Restrict)
  revisions           TrackRevision[] @relation("TrackRevisions")
  publishedRevision   TrackRevision?  @relation("PublishedTrackRevision", fields: [id, publishedRevisionId], references: [trackId, id], onDelete: Restrict)
  scheduledRevision   TrackRevision?  @relation("ScheduledTrackRevision", fields: [id, scheduledRevisionId], references: [trackId, id], onDelete: Restrict)
  auditLogs           TrackAuditLog[]
  releaseTracks       ReleaseTrack[]

  @@index([primaryArtistId])
  @@index([secondaryArtistId])
  @@index([labelId])
  @@index([status])
  @@index([scheduledFor])
  @@map("tracks")
}

model TrackRevision {
  id                      String                 @id @default(uuid()) @db.Uuid
  trackId                 String                 @db.Uuid
  revisionNumber          Int
  sourceWorkingVersion    Int
  title                   String
  primaryArtistId         String                 @db.Uuid
  primaryArtistLegacyId   Int
  primaryArtistName       String
  secondaryArtistId       String?                @db.Uuid
  secondaryArtistLegacyId Int?
  secondaryArtistName     String?
  labelId                 String                 @db.Uuid
  labelName               String
  labelLegacyValue        String
  durationMs              Int?
  spotifyUrl              String?
  beatportUrl             String?
  traxsourceUrl           String?
  bandcampUrl             String?
  appleMusicUrl           String?
  soundcloudUrl           String?
  createdById             String                 @db.Uuid
  createdAt               DateTime               @default(now()) @db.Timestamptz(6)
  track                   Track                  @relation("TrackRevisions", fields: [trackId], references: [id], onDelete: Restrict)
  primaryArtist           Artist                 @relation("TrackRevisionPrimaryArtist", fields: [primaryArtistId], references: [id], onDelete: Restrict)
  secondaryArtist         Artist?                @relation("TrackRevisionSecondaryArtist", fields: [secondaryArtistId], references: [id], onDelete: Restrict)
  label                   Label                  @relation(fields: [labelId], references: [id], onDelete: Restrict)
  createdBy               User                   @relation(fields: [createdById], references: [id], onDelete: Restrict)
  publishedByTracks       Track[]                @relation("PublishedTrackRevision")
  scheduledForTracks      Track[]                @relation("ScheduledTrackRevision")
  releaseRevisionTracks   ReleaseRevisionTrack[]

  @@unique([trackId, revisionNumber])
  @@unique([trackId, id])
  @@index([primaryArtistId])
  @@index([secondaryArtistId])
  @@index([labelId])
  @@index([createdById])
  @@map("track_revisions")
}

model TrackAuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  trackId   String      @db.Uuid
  actorId   String?     @db.Uuid
  action    AuditAction
  metadata  Json?
  createdAt DateTime    @default(now()) @db.Timestamptz(6)
  track     Track       @relation(fields: [trackId], references: [id], onDelete: Restrict)
  actor     User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([trackId, createdAt])
  @@index([actorId])
  @@map("track_audit_logs")
}

model PodcastEpisode {
  id                  String                   @id @default(uuid()) @db.Uuid
  legacyId            Int                      @unique @default(autoincrement())
  title               String
  primaryArtistId     String                   @db.Uuid
  secondaryArtistId   String?                  @db.Uuid
  labelId             String                   @db.Uuid
  episodeDate         DateTime?                @db.Date
  durationMs          Int?
  status              PodcastStatus            @default(DRAFT)
  workingVersion      Int                      @default(1)
  publishedRevisionId String?                  @db.Uuid
  scheduledRevisionId String?                  @db.Uuid
  scheduledFor        DateTime?                @db.Timestamptz(6)
  archivedAt          DateTime?                @db.Timestamptz(6)
  createdAt           DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                 @updatedAt @db.Timestamptz(6)
  primaryArtist       Artist                   @relation("PodcastPrimaryArtist", fields: [primaryArtistId], references: [id], onDelete: Restrict)
  secondaryArtist     Artist?                  @relation("PodcastSecondaryArtist", fields: [secondaryArtistId], references: [id], onDelete: Restrict)
  label               Label                    @relation(fields: [labelId], references: [id], onDelete: Restrict)
  chapters            PodcastChapter[]
  revisions           PodcastEpisodeRevision[] @relation("PodcastRevisions")
  publishedRevision   PodcastEpisodeRevision?  @relation("PublishedPodcastRevision", fields: [id, publishedRevisionId], references: [episodeId, id], onDelete: Restrict)
  scheduledRevision   PodcastEpisodeRevision?  @relation("ScheduledPodcastRevision", fields: [id, scheduledRevisionId], references: [episodeId, id], onDelete: Restrict)
  auditLogs           PodcastAuditLog[]

  @@index([primaryArtistId])
  @@index([secondaryArtistId])
  @@index([labelId])
  @@index([episodeDate])
  @@index([status])
  @@index([scheduledFor])
  @@map("podcast_episodes")
}

model PodcastChapter {
  id              String         @id @default(uuid()) @db.Uuid
  episodeId       String         @db.Uuid
  position        Int
  artist          String
  title           String
  legacyReference String?
  durationMs      Int?
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(6)
  episode         PodcastEpisode @relation(fields: [episodeId], references: [id], onDelete: Restrict)

  @@unique([episodeId, position])
  @@index([episodeId])
  @@map("podcast_chapters")
}

model PodcastEpisodeRevision {
  id                      String                   @id @default(uuid()) @db.Uuid
  episodeId               String                   @db.Uuid
  revisionNumber          Int
  sourceWorkingVersion    Int
  title                   String
  primaryArtistId         String                   @db.Uuid
  primaryArtistLegacyId   Int
  primaryArtistName       String
  secondaryArtistId       String?                  @db.Uuid
  secondaryArtistLegacyId Int?
  secondaryArtistName     String?
  labelId                 String                   @db.Uuid
  labelName               String
  labelLegacyValue        String
  episodeDate             DateTime                 @db.Date
  durationMs              Int?
  createdById             String                   @db.Uuid
  createdAt               DateTime                 @default(now()) @db.Timestamptz(6)
  episode                 PodcastEpisode           @relation("PodcastRevisions", fields: [episodeId], references: [id], onDelete: Restrict)
  primaryArtist           Artist                   @relation("PodcastRevisionPrimaryArtist", fields: [primaryArtistId], references: [id], onDelete: Restrict)
  secondaryArtist         Artist?                  @relation("PodcastRevisionSecondaryArtist", fields: [secondaryArtistId], references: [id], onDelete: Restrict)
  label                   Label                    @relation(fields: [labelId], references: [id], onDelete: Restrict)
  createdBy               User                     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  chapters                PodcastChapterRevision[]
  publishedByEpisodes     PodcastEpisode[]         @relation("PublishedPodcastRevision")
  scheduledForEpisodes    PodcastEpisode[]         @relation("ScheduledPodcastRevision")

  @@unique([episodeId, revisionNumber])
  @@unique([episodeId, id])
  @@index([primaryArtistId])
  @@index([secondaryArtistId])
  @@index([labelId])
  @@index([createdById])
  @@map("podcast_episode_revisions")
}

model PodcastChapterRevision {
  id                String                 @id @default(uuid()) @db.Uuid
  episodeRevisionId String                 @db.Uuid
  sourceChapterId   String?                @db.Uuid
  position          Int
  artist            String
  title             String
  legacyReference   String?
  durationMs        Int?
  episodeRevision   PodcastEpisodeRevision @relation(fields: [episodeRevisionId], references: [id], onDelete: Restrict)

  @@unique([episodeRevisionId, position])
  @@index([episodeRevisionId])
  @@map("podcast_chapter_revisions")
}

model PodcastAuditLog {
  id        String         @id @default(uuid()) @db.Uuid
  episodeId String         @db.Uuid
  actorId   String?        @db.Uuid
  action    AuditAction
  metadata  Json?
  createdAt DateTime       @default(now()) @db.Timestamptz(6)
  episode   PodcastEpisode @relation(fields: [episodeId], references: [id], onDelete: Restrict)
  actor     User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([episodeId, createdAt])
  @@index([actorId])
  @@map("podcast_audit_logs")
}

model Release {
  id                  String            @id @default(uuid()) @db.Uuid
  legacyId            Int               @unique @default(autoincrement())
  title               String
  primaryArtistId     String            @db.Uuid
  secondaryArtistId   String?           @db.Uuid
  releaseDate         DateTime?         @db.Date
  labelId             String            @db.Uuid
  spotifyUrl          String?
  beatportUrl         String?
  traxsourceUrl       String?
  bandcampUrl         String?
  appleMusicUrl       String?
  soundcloudUrl       String?
  status              ReleaseStatus     @default(DRAFT)
  workingVersion      Int               @default(1)
  publishedRevisionId String?           @db.Uuid
  scheduledRevisionId String?           @db.Uuid
  scheduledFor        DateTime?         @db.Timestamptz(6)
  archivedAt          DateTime?         @db.Timestamptz(6)
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(6)
  primaryArtist       Artist            @relation("ReleasePrimaryArtist", fields: [primaryArtistId], references: [id], onDelete: Restrict)
  secondaryArtist     Artist?           @relation("ReleaseSecondaryArtist", fields: [secondaryArtistId], references: [id], onDelete: Restrict)
  label               Label             @relation(fields: [labelId], references: [id], onDelete: Restrict)
  tracks              ReleaseTrack[]
  revisions           ReleaseRevision[] @relation("ReleaseRevisions")
  publishedRevision   ReleaseRevision?  @relation("PublishedReleaseRevision", fields: [id, publishedRevisionId], references: [releaseId, id], onDelete: Restrict)
  scheduledRevision   ReleaseRevision?  @relation("ScheduledReleaseRevision", fields: [id, scheduledRevisionId], references: [releaseId, id], onDelete: Restrict)
  auditLogs           ReleaseAuditLog[]

  @@index([primaryArtistId])
  @@index([secondaryArtistId])
  @@index([labelId])
  @@index([releaseDate])
  @@index([status])
  @@index([scheduledFor])
  @@map("releases")
}

model ReleaseTrack {
  id        String   @id @default(uuid()) @db.Uuid
  releaseId String   @db.Uuid
  trackId   String   @db.Uuid
  position  Int
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  release   Release  @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Restrict)

  @@unique([releaseId, trackId])
  @@unique([releaseId, position])
  @@index([trackId])
  @@map("release_tracks")
}

model ReleaseRevision {
  id                      String                 @id @default(uuid()) @db.Uuid
  releaseId               String                 @db.Uuid
  revisionNumber          Int
  sourceWorkingVersion    Int
  title                   String
  primaryArtistId         String                 @db.Uuid
  primaryArtistLegacyId   Int
  primaryArtistName       String
  secondaryArtistId       String?                @db.Uuid
  secondaryArtistLegacyId Int?
  secondaryArtistName     String?
  labelId                 String                 @db.Uuid
  labelName               String
  labelLegacyValue        String
  releaseDate             DateTime               @db.Date
  spotifyUrl              String?
  beatportUrl             String?
  traxsourceUrl           String?
  bandcampUrl             String?
  appleMusicUrl           String?
  soundcloudUrl           String?
  createdById             String                 @db.Uuid
  createdAt               DateTime               @default(now()) @db.Timestamptz(6)
  release                 Release                @relation("ReleaseRevisions", fields: [releaseId], references: [id], onDelete: Restrict)
  primaryArtist           Artist                 @relation("ReleaseRevisionPrimaryArtist", fields: [primaryArtistId], references: [id], onDelete: Restrict)
  secondaryArtist         Artist?                @relation("ReleaseRevisionSecondaryArtist", fields: [secondaryArtistId], references: [id], onDelete: Restrict)
  label                   Label                  @relation(fields: [labelId], references: [id], onDelete: Restrict)
  createdBy               User                   @relation(fields: [createdById], references: [id], onDelete: Restrict)
  tracks                  ReleaseRevisionTrack[]
  publishedByReleases     Release[]              @relation("PublishedReleaseRevision")
  scheduledForReleases    Release[]              @relation("ScheduledReleaseRevision")

  @@unique([releaseId, revisionNumber])
  @@unique([releaseId, id])
  @@index([primaryArtistId])
  @@index([secondaryArtistId])
  @@index([labelId])
  @@index([createdById])
  @@map("release_revisions")
}

model ReleaseRevisionTrack {
  id                String          @id @default(uuid()) @db.Uuid
  releaseRevisionId String          @db.Uuid
  trackRevisionId   String          @db.Uuid
  position          Int
  releaseRevision   ReleaseRevision @relation(fields: [releaseRevisionId], references: [id], onDelete: Restrict)
  trackRevision     TrackRevision   @relation(fields: [trackRevisionId], references: [id], onDelete: Restrict)

  @@unique([releaseRevisionId, trackRevisionId])
  @@unique([releaseRevisionId, position])
  @@index([trackRevisionId])
  @@map("release_revision_tracks")
}

model ReleaseAuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  releaseId String      @db.Uuid
  actorId   String?     @db.Uuid
  action    AuditAction
  metadata  Json?
  createdAt DateTime    @default(now()) @db.Timestamptz(6)
  release   Release     @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  actor     User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([releaseId, createdAt])
  @@index([actorId])
  @@map("release_audit_logs")
}
